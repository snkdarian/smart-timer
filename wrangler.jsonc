{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smart-timer",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/smart-timer/browser",
    "not_found_handling": "single-page-application"
  }
}
